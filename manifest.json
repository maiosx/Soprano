{
  "schemaVersion": 1,
  "id": "soprano.quotes",
  "name": "Soprano",
  "version": "1.0.0",
  "author": "maiosx",
  "license": "MIT",
  "description": "Fullscreen overlay of quotes from The Sopranos. Click for another.",
  "kinds": ["overlay", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Soprano.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Soprano",
    "description": "Open the Soprano quotes overlay",
    "category": "Desktop",
    "aliases": ["soprano", "quotes", "tony", "family"],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
